<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="red-sphere">

    <!--general object params -->
    <static>false</static>

    <link name="link">

      <!--pose of link relative to model-->
      <pose>0 0 0 0 0 0</pose>
    
      <visual name="visual">
          <geometry>
              <sphere>
                  <radius>0.041</radius> <!--should be in cm-->
              </sphere>
          </geometry>
          <material>
              <ambient>0.8 0.0 0.0 1.0</ambient>
              <diffuse>0.8 0.0 0.0 1.0</diffuse>
              <specular>0.1 0.1 0.1 1.0</specular>
              <emissive>0 0 0 1</emissive>
          </material>
      </visual>

      <collision name="collision">
          <geometry>
              <sphere>
                  <radius>0.041</radius> <!--should be in cm-->
              </sphere>
          </geometry>
      </collision>

      <inertial>
        <mass>0.04</mass> <!--units are in kg. 1g = 0.001kg-->
        <inertia>
          <ixx>0.0002</ixx>
          <iyy>0.0002</iyy>
          <izz>0.0002</izz>
        </inertia>
      </inertial>

    </link>
    
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <publish_model_pose>true</publish_model_pose>
      <publish_nested_model_pose>true</publish_nested_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>20</update_frequency> <!-- Publish at 20 Hz -->
      <static_publisher>false</static_publisher>
      <static_update_frequency>1</static_update_frequency>
    </plugin>
  </model>
</sdf>


