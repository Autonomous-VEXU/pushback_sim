<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="vex-ball-sr">

    <!--general object params -->
    <static>false</static>

    <link name="link">

      <!--pose of link relative to model-->
      <pose>0 0 0 0 0 0</pose>
    
        <visual name="visual">
            <geometry>
                <sphere>
                    <radius>0.041</radius> <!--should be in cm-->
                </sphere>
            </geometry>
        </visual>

        <collision name="collision">
            <geometry>
                <sphere>
                    <radius>0.041</radius> <!--should be in cm-->
                </sphere>
            </geometry>
        </collision>

      <inertial>
        <mass>0.04</mass> <!--units are in kg. 1g = 0.001kg-->
        <inertia>
          <ixx>0.0002</ixx>
          <iyy>0.0002</iyy>
          <izz>0.0002</izz>
        </inertia>
      </inertial>

    </link>
  </model>
</sdf>